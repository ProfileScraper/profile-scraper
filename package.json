{
  "name": "profile-scraper",
  "version": "1.5.12",
  "description": "Profile-based web scraper with Electron and patchright",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5174 && tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron . --require dotenv/config",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "test": "jest",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:intel": "node scripts/install-browsers-darwin-x64.js && npm run build && electron-builder --mac --x64",
    "package:mac:arm": "node scripts/install-browsers-darwin-arm64.js && npm run build && electron-builder --mac --arm64",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl"
  },
  "keywords": [
    "scraper",
    "electron",
    "patchright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "csv-writer": "^1.6.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "patchright": "^1.56.1",
    "react": "^19.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.2.2",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "jest": "^30.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "wait-on": "^9.0.1"
  }
}
